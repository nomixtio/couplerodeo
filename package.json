{
  "name": "couplerodeo",
  "private": false,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:workers && npm run test:e2e",
    "predeploy": "node scripts/bump-version.mjs",
    "deploy": "vite build && wrangler deploy -c $(node scripts/wrangler-config.mjs)",
    "deploy:website": "wrangler deploy -c website/wrangler.jsonc",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:openmoji": "node scripts/generate-openmoji-catalog.mjs",
    "import:punk-emojis": "node scripts/import-punk-emojis.mjs",
    "dev:website": "wrangler dev -c website/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply couplerodeo-db --local",
    "db:migrate:e2e": "wrangler d1 migrations apply couplerodeo-db --local --config wrangler.e2e.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply couplerodeo-db --remote -c $(node scripts/wrangler-config.mjs)",
    "db:reset:local": "wrangler d1 execute couplerodeo-db --local --file=scripts/db-reset.sql",
    "db:reset:remote": "wrangler d1 execute couplerodeo-db --remote --file=scripts/db-reset.sql -c $(node scripts/wrangler-config.mjs)",
    "types": "wrangler types",
    "alchemy:plan": "alchemy plan",
    "deploy:staging": "npm run build && alchemy deploy --stage staging",
    "deploy:production": "npm run build && alchemy deploy --stage production",
    "destroy:preview": "alchemy destroy"
  },
  "dependencies": {
    "@pushforge/builder": "^1.0.0",
    "@silk-hq/components": "^0.10.1",
    "@tanstack/react-router": "^1.121.0",
    "hono": "^4.13.9",
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/vitest-plugin": "^1.1.11",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@playwright/test": "^1.63.0",
    "@tanstack/router-devtools": "^1.121.0",
    "@tanstack/router-plugin": "^1.121.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "alchemy": "2.0.0-beta.77",
    "effect": "4.0.0-rc.112",
    "jsdom": "^30.1.0",
    "oxlint": "^1.71.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
