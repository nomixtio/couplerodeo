{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "couplerodeo",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/assets/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "couplerodeo-db",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"remote": true
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"stream": {
		"binding": "STREAM"
	},
	"vars": {
		"VAPID_PUBLIC_KEY": "REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY"
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
		"enabled": true,
		"head_sampling_rate": 1,
		"persist": true,
		"invocation_logs": true
		},
		"traces": {
		"enabled": false,
		"persist": true,
		"head_sampling_rate": 1
		}
	}
}