# Copy to .dev.vars and fill in your VAPID private key (JWK JSON on one line)
# Generate with: npx @pushforge/builder vapid
VAPID_PRIVATE_KEY={"alg":"ES256","key_ops":["sign"],"ext":true,"kty":"EC","x":"...","y":"...","crv":"P-256","d":"..."}

# Giphy API key for update GIF reactions — https://developers.giphy.com/
GIPHY_API_KEY=
